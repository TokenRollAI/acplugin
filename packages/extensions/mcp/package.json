{
  "name": "@tokenroll/acplugin-extension-mcp",
  "version": "1.0.0",
  "description": "Portable MCP authoring and platform adapters for acplugin.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/TokenRollAI/acplugin#mcp-extension",
  "repository": { "type": "git", "url": "git+https://github.com/TokenRollAI/acplugin.git", "directory": "packages/extensions/mcp" },
